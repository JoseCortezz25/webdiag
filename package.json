{
  "name": "webdiag",
  "version": "0.1.0",
  "description": "Automated technical diagnostics for websites: measure once, report deterministically.",
  "license": "MIT",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "webdiag": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target bun --minify --external lighthouse --external puppeteer --external @puppeteer/browsers --external chrome-launcher --external retire && chmod +x dist/cli.js",
    "install:testssl": "bash scripts/install-testssl.sh",
    "dev": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.2",
    "axe-core": "4.13.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "puppeteer": "25.10.0",
    "retire": "^5.7.0",
    "zod": "4.5.4"
  }
}
