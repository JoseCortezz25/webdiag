{
  "name": "webdiag",
  "version": "0.1.0",
  "description": "Automated technical diagnostics for websites: measure once, report deterministically.",
  "license": "MIT",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "webdiag": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target bun --minify && chmod +x dist/cli.js",
    "dev": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
